{
  "name": "ccpc-new-standings",
  "version": "1.2.0",
  "private": true,
  "description": "Cross-browser extension for the CCPC standings display on QOJ",
  "scripts": {
    "build": "python scripts/build.py",
    "test": "node --test tests/engine.test.cjs tests/compatibility.test.cjs",
    "test:browser": "node tests/browser.test.cjs",
    "test:edge": "node tests/browser.test.cjs msedge",
    "test:extension": "node tests/extension.test.cjs",
    "test:firefox": "node tests/firefox-extension.test.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
