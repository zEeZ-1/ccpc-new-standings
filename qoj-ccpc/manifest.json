{
  "manifest_version": 3,
  "name": "QOJ · CCPC 新榜单",
  "version": "1.1.1",
  "description": "按 CCPC 2026 新榜单模式隐藏题号，并为每支队伍重新排列解题情况。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://qoj.ac/contest/*/standings*", "https://*.qoj.ac/contest/*/standings*", "https://contest.ucup.ac/contest/*/standings*", "https://jiang.ly/contest/*/standings*", "https://huang.lt/contest/*/standings*", "https://oj.qiuly.org/contest/*/standings*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://qoj.ac/contest/*/standings*", "https://*.qoj.ac/contest/*/standings*", "https://contest.ucup.ac/contest/*/standings*", "https://jiang.ly/contest/*/standings*", "https://huang.lt/contest/*/standings*", "https://oj.qiuly.org/contest/*/standings*"],
      "js": ["engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
